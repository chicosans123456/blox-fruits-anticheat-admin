--// Coloque este Script em ServerScriptService

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local BanStore = DataStoreService:GetDataStore("MYGAME43_Bans_V2")

--// CONFIGURAÇÃO
local ADMINS = {
    ["Dosangrlio9"] = true,
}

local PREFIX = "!"

--// Verificar administrador
local function IsAdmin(player)
    return ADMINS[player.Name] == true
end

--// Encontrar jogador
local function FindPlayer(name)
    if not name then
        return nil
    end

    name = string.lower(name)

    for _, player in ipairs(Players:GetPlayers()) do
        if string.lower(player.Name) == name
            or string.sub(string.lower(player.Name), 1, #name) == name then
            return player
        end
    end

    return nil
end

--// Salvar banimento
local function SaveBan(userId, duration, reason)
    local success, err = pcall(function()
        BanStore:SetAsync(tostring(userId), {
            expires = duration,
            reason = reason or "Banido pela administração",
        })
    end)

    if not success then
        warn("Erro ao salvar banimento:", err)
    end

    return success
end

--// Remover banimento
local function RemoveBan(userId)
    local success, err = pcall(function()
        BanStore:RemoveAsync(tostring(userId))
    end)

    if not success then
        warn("Erro ao remover banimento:", err)
    end

    return success
end

--// Verificar banimento ao entrar
Players.PlayerAdded:Connect(function(player)
    local success, data = pcall(function()
        return BanStore:GetAsync(tostring(player.UserId))
    end)

    if success and data then
        if data.expires == 0 or os.time() < data.expires then
            player:Kick(
                "Você está banido do MYGAME43.\nMotivo: "
                .. tostring(data.reason)
            )
            return
        else
            RemoveBan(player.UserId)
        end
    end

    player.Chatted:Connect(function(message)
        if not IsAdmin(player) then
            return
        end

        local args = string.split(message, " ")
        local command = string.lower(args[1] or "")

        --// KICK
        if command == PREFIX .. "kick" then
            local target = FindPlayer(args[2])

            if target and target ~= player then
                target:Kick("Você foi expulso do MYGAME43.")
            end
        end

        --// BAN PERMANENTE
        if command == PREFIX .. "ban" then
            local target = FindPlayer(args[2])

            if target and target ~= player then
                local success = SaveBan(
                    target.UserId,
                    0,
                    "Banimento permanente"
                )

                if success then
                    target:Kick(
                        "Você foi banido permanentemente do MYGAME43."
                    )
                end
            end
        end

        --// BAN TEMPORÁRIO
        if command == PREFIX .. "tempban" then
            local target = FindPlayer(args[2])
            local minutes = tonumber(args[3])

            if target and target ~= player
                and minutes
                and minutes > 0
                and minutes <= 43200 then

                local expires = os.time() + (minutes * 60)

                local success = SaveBan(
                    target.UserId,
                    expires,
                    "Banimento temporário"
                )

                if success then
                    target:Kick(
                        "Você foi banido por "
                        .. minutes
                        .. " minutos."
                    )
                end
            end
        end

        --// UNBAN
        if command == PREFIX .. "unban" then
            local username = args[2]

            if username then
                local success, userId = pcall(function()
                    return Players:GetUserIdFromNameAsync(username)
                end)

                if success and userId then
                    RemoveBan(userId)
                end
            end
        end
    end)
end)

