local serverSource = [==[
-- mygame43 | AdminServer
-- ServerScriptService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local OWNER_USER_ID = 5618088588

local ADMINS = {
    [OWNER_USER_ID] = true,
}

local remote = ReplicatedStorage:FindFirstChild("AdminRemote")

if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "AdminRemote"
    remote.Parent = ReplicatedStorage
end

local function isAdmin(player)
    return ADMINS[player.UserId] == true
end

local function notify(player, message)
    remote:FireClient(player, "Notify", message)
end

local function getPlayers()
    local list = {}

    for _, target in ipairs(Players:GetPlayers()) do
        table.insert(list, {
            Name = target.Name,
            DisplayName = target.DisplayName,
            UserId = target.UserId,
        })
    end

    return list
end

local function banPlayer(admin, targetUserId, duration, reason)
    if not isAdmin(admin) then
        return
    end

    if typeof(targetUserId) ~= "number" then
        return
    end

    if targetUserId == admin.UserId then
        notify(admin, "Voce nao pode banir a si mesmo.")
        return
    end

    if typeof(duration) ~= "number" then
        return
    end

    if duration ~= -1 then
        duration = math.floor(duration)

        if duration < 60 or duration > 2592000 then
            notify(admin, "Duracao invalida.")
            return
        end
    end

    reason = tostring(reason or "Violacao das regras.")
    reason = string.sub(reason, 1, 400)

    local success, err = pcall(function()
        Players:BanAsync({
            UserIds = {targetUserId},
            ApplyToUniverse = true,
            Duration = duration,
            DisplayReason = reason,
            PrivateReason = "mygame43 Admin: "
                .. admin.UserId .. " | " .. reason,
            ExcludeAltAccounts = false,
        })
    end)

    if not success then
        warn("[mygame43] Ban falhou:", err)
        notify(admin, "Erro ao banir. Veja o Output.")
        return
    end

    notify(admin, "Banimento aplicado com sucesso!")

    local target = Players:GetPlayerByUserId(targetUserId)

    if target then
        target:Kick(
            "Voce foi banido do mygame43.\n\nMotivo: "
            .. reason
        )
    end
end

remote.OnServerEvent:Connect(function(player, action, data)
    if not isAdmin(player) then
        warn("[mygame43] Acesso negado:", player.Name)
        return
    end

    if action == "RequestPlayers" then
        remote:FireClient(player, "PlayersList", getPlayers())

    elseif action == "Ban" then
        if typeof(data) ~= "table" then
            return
        end

        banPlayer(
            player,
            data.UserId,
            data.Duration,
            data.Reason
        )
    end
end)

print("[mygame43] AdminServer iniciado!")
]==]

